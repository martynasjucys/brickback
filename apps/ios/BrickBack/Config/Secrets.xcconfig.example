// Secrets.xcconfig — TEMPLATE. Copy to `Secrets.xcconfig` (gitignored) and fill in.
//
// Values are the five CLIENT-SAFE (publishable) values, copied straight from
// apps/mobile/.env. Never put a server secret here.
//
// xcconfig gotcha: `//` starts a comment, so a bare `https://host` is truncated to
// `https:`. Split the two slashes with an empty `$()` substitution — `https:/$()/host`
// resolves to `https://host` at build time. (The anon keys contain no `//`, so they
// are written verbatim.)
//
// The apps/ios/gen-secrets.sh script regenerates the real file from apps/mobile/.env.

USER_SUPABASE_URL = https:/$()/YOUR-USER-PROJECT.supabase.co
USER_SUPABASE_ANON_KEY = sb_publishable_xxx
CATALOG_SUPABASE_URL = https:/$()/YOUR-CATALOG-PROJECT.supabase.co
CATALOG_SUPABASE_ANON_KEY = sb_publishable_xxx
CDN_URL = https:/$()/your-cdn-host
